<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the app read the same usage stats Digital Wellbeing uses.
         The user grants it manually under Settings > Special app access > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed on Android 11+ so installed apps can be listed and given readable names. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Spotify's App Remote SDK talks to the installed Spotify app over this. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Alarms: vibration when one rings, and re-arming every alarm after the phone reboots
         (AlarmManager entries don't survive a restart on their own). setAlarmClock itself
         needs no special permission on any API level. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Medication reminders (Android 13+ asks at runtime). Data never leaves the phone. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Optional: reads period-start dates from Health Connect, if the user taps "Import
         from watch" and a source app (Samsung Health, Fitbit, Flo, etc.) has written any. -->
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />

    <!-- Optional: only requested if the user taps "Connect Health Connect" on the Watch & vitals
         screen — reads heart rate, heart-rate variability and sleep sessions a watch app has
         already saved to Health Connect. Read-only; nothing is written back. -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" />
    <uses-permission android:name="android.permission.health.READ_SLEEP" />

    <!-- Optional: only requested if the user taps "Import from Contacts" on the Birthdays
         screen — reads contact names + birthdays already on the device (this picks up any
         synced account's contacts, including a Google account's, not just ones added
         manually). Declining it just means typing birthdays in by hand instead. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Optional: only requested if the user turns on "Add to Calendar" while adding a To-do
         task — writes (and, if the task is deleted, removes) a single event on the device's
         default calendar. Declining it just means the task stays local-only, same as before. -->
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Lets FocusLens see the Spotify app (Android 11+ hides other apps otherwise). -->
    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Spotify's sign-in returns here: focuslens://auth -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="focuslens" android:host="auth" />
            </intent-filter>
        </activity>

        <!-- The pause screen shown over a blocked app. -->
        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Covers every app device-wide during a Hyper Focus session. -->
        <activity
            android:name=".HyperFocusBlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Pause screen for a blocked app during an active block schedule. -->
        <activity
            android:name=".SchedulePauseActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Shown for a specific blocked feature (Reels, Shorts) or a blocked site in Chrome. -->
        <activity
            android:name=".FeatureBlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Doom-scroll reminder — a nudge, not a block; see ScrollReminderActivity. -->
        <activity
            android:name=".ScrollReminderActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- The real, survives-closing-the-app alarm screen (see AlarmRingActivity). -->
        <activity
            android:name=".AlarmRingActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Fired by AlarmManager when a scheduled alarm's time arrives. -->
        <receiver android:name=".AlarmReceiver" android:exported="false" />

        <!-- Medication reminder notifications and their Mark taken / Snooze buttons. -->
        <receiver android:name=".MedReminderReceiver" android:exported="false" />

        <!-- Re-arms every enabled alarm after the phone reboots. -->
        <receiver android:name=".BootReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Detects which app is in front. Needs the user to switch it on in Accessibility settings. -->
        <service
            android:name=".FocusAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="${applicationId}.fileprovider"
        android:exported="false"
        android:grantUriPermissions="true">
        <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
    </provider>
</application>
</manifest>
