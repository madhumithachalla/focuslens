<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets the app read the same usage stats Digital Wellbeing uses.
         The user grants it manually under Settings > Special app access > Usage access. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Needed on Android 11+ so installed apps can be listed and given readable names. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Spotify's App Remote SDK talks to the installed Spotify app over this. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Optional: reads period-start dates from Health Connect, if the user taps "Import
         from watch" and a source app (Samsung Health, Fitbit, Flo, etc.) has written any. -->
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/ic_menu_view"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The pause screen shown over a blocked app. -->
        <activity
            android:name=".BlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Covers every app device-wide during a Hyper Focus session. -->
        <activity
            android:name=".HyperFocusBlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Shown for a specific blocked feature (Reels, Shorts) or a blocked site in Chrome. -->
        <activity
            android:name=".FeatureBlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- Detects which app is in front. Needs the user to switch it on in Accessibility settings. -->
        <service
            android:name=".FocusAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
