                android:fillColor="#4EA8F7"
                android:pathData="M 5 80 C 10 68, 22 58, 40 56 C 55 54, 62 46, 72 36 C 95 16, 135 10, 168 22 C 198 33, 210 58, 200 82 C 193 98, 175 110, 155 113 C 130 117, 100 115, 78 104 C 58 95, 42 88, 30 86 C 20 85, 11 84, 5 80 Z" />
