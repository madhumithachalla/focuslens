rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each user can only ever read/write their own profile doc and their own
    // mirrored app-state doc — never another uid's.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
